# Installed on BOTH machines. `brew bundle --file=Brewfile`
# This is the intersection of what the two actually have, plus starship, which
# shell/common.zsh now depends on for the prompt.
brew "bat"   # cat
brew "eza"   # ls
brew "fd"   # find
brew "fzf"
brew "git-delta"   # diff pager
brew "ripgrep"   # grep
brew "zoxide"   # cd
brew "starship"   # prompt; config/starship.toml is the Mini's glass theme

# Vim workflow + scripting (config/nvim, config/zellij, bin/newscript)
brew "neovim"
brew "zellij"
brew "lazygit"
brew "shellcheck"   # bash linting; LazyVim's bashls uses it too
brew "shfmt"

# Fonts (both machines: Ghostty and Obsidian read the same names)
cask "font-jetbrains-mono-nerd-font"   # code; Ghostty font-family
cask "font-inter"                      # prose and UI; pairs with JetBrains Mono
