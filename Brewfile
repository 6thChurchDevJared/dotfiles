# Installed on BOTH machines. `brew bundle --file=Brewfile`
# This is the intersection of what the two actually have, plus starship, which
# shell/common.zsh now depends on for the prompt.
tap "homebrew/bundle"

brew "bat"   # cat
brew "eza"   # ls
brew "fd"   # find
brew "fzf"
brew "git-delta"   # diff pager
brew "ripgrep"   # grep
brew "zoxide"   # cd
brew "starship"   # prompt; config/starship.toml is the Mini's glass theme
