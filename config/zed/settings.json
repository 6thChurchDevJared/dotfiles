// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  // Extensions this machine should have. Zed installs anything missing at
  // startup, which is how the two machines stay matched — there is no CLI
  // for this, and install.sh does not touch it.
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "csv": true,
    "dockerfile": true,
    "dracula": true,
    "fastapi-snippets": true,
    "flask-snippets": true,
    "git-firefly": true,
    "helm": true,
    "html": true,
    "html-snippets": true,
    "ini": true,
    "javascript-snippets": true,
    "jetbrains-new-ui-icons": true,
    "kubernetes-snippets": true,
    "log": true,
    "lua": true,
    "macos-classic": true,
    "make": true,
    "material-icon-theme": true,
    "nestjs-snippets": true,
    "nvim-nightfox": true,
    "python-requirements": true,
    "python-snippets": true,
    "react-snippets": true,
    "react-typescript-snippets": true,
    "rust-snippets": true,
    "sql": true,
    "terraform": true,
    "tokyo-night": true,
    "toml": true,
    "typescript-snippets": true
  },

  "vim_mode": true,
  "base_keymap": "VSCode",
  "minimap": {
    "show": "always"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Carbonfox - opaque",
  },

  // --- Python / Ruff --------------------------------------------------------
  // basedpyright (types, PEP 484) + ruff (lint/format, PEP 8/257) ship built
  // into Zed — no extensions to install. Ruff auto-discovers the repo's
  // ruff.toml, so rules live in the repo (single source of truth), NOT here.
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "ruff" } }],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      },
      "show_wrap_guides": true,
      "wrap_guides": [100]
    }
  },
  "lsp": {
    // Leave ruff init options empty: defer entirely to the repo ruff.toml.
    "ruff": {},
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "standard",
            "diagnosticMode": "openFilesOnly",
            "inlayHints": {
              "functionReturnTypes": true,
              "variableTypes": false,
              "callArgumentNames": false
            }
          }
        }
      }
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": false
  },
}
