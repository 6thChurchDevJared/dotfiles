# ─────────────────────────────────────────────────────────────
#  Ghostty — glass
#  Reload in-app with cmd+shift+, (or Cmd-P → "Reload Config")
# ─────────────────────────────────────────────────────────────

# ── Font ─────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Thicker stems — makes text hold up against a transparent
# background instead of dissolving into the wallpaper.
font-thicken = true

# A little air between lines. Biggest single readability win.
adjust-cell-height = 12%

# JetBrains Mono ligatures (-> => != ===) are on by default.
# Uncomment to turn them off:
# font-feature = -calt
# font-feature = -liga


# ── Glass ────────────────────────────────────────────────────
# The wallpaper is the point; the terminal is a pane of glass
# over it. Blur is what keeps text readable at this opacity.
background-opacity = 0.65
background-blur = 26

# Don't double-dim inactive splits — 0.7 on top of 0.65 is mud.
unfocused-split-opacity = 0.92

# Guarantees fg/bg never collapse into each other, whatever an
# app throws at the screen.
minimum-contrast = 1.1
bold-is-bright = true


# ── Palette ──────────────────────────────────────────────────
# Near-black and deliberately untinted, so the background reads
# as *your wallpaper* rather than a colored film over it.
# Colors run bright/saturated to survive 65% opacity.
background = #0d0d10
foreground = #e8e8ea
cursor-color = #7ee0ff
cursor-text = #0d0d10
selection-background = #2f3b4d
selection-foreground = #ffffff

# normal
palette = 0=#1c1c20
palette = 1=#ff6b6b
palette = 2=#5fd77f
palette = 3=#ffbd5f
palette = 4=#5fafff
palette = 5=#d787ff
palette = 6=#5fe3d7
palette = 7=#d0d0d4
# bright
palette = 8=#5a5a62
palette = 9=#ff9494
palette = 10=#87ff9f
palette = 11=#ffd787
palette = 12=#87d7ff
palette = 13=#e7b3ff
palette = 14=#87ffe7
palette = 15=#ffffff


# ── Window ───────────────────────────────────────────────────
# Padding gives the glass an edge; content jammed to the frame
# ruins the effect.
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-save-state = always

macos-titlebar-style = transparent
macos-window-shadow = true


# ── Scrollback ───────────────────────────────────────────────
# Bytes, not lines. 256MB ≈ several million lines of output.
scrollback-limit = 256000000


# ── Behavior ─────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard


# ── Function ─────────────────────────────────────────────────
# Appended when the Mac Mini's "glass" config was adopted. The block
# above is the Mini's and wins on everything visual. These are fixes
# and bindings, not preferences, so they are shared. Ghostty takes the
# last value for single-value keys, so this section overrides above.

# Fix Claude Code / TUI text overlap & ghosting on Ghostty 1.3+.
# Ghostty's default `unicode` width method desyncs the cursor against
# apps that measure with wcswidth (Claude Code's Ink renderer). `legacy`
# uses POSIX wcswidth tables and aligns the two. Do not remove: this was
# diagnosed the hard way, and starship was the red herring.
grapheme-width-method = legacy

# Claude Code: Shift+Enter inserts a newline instead of submitting.
keybind = shift+enter=text:\n

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface

# Shell integration: cursor shape, sudo askpass, window title.
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# macOS: make Option send Meta (readline word-jump, alt keybinds).
macos-option-as-alt = true
