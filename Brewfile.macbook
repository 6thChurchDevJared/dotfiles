# Work MacBook Pro only. `brew bundle --file=Brewfile.macbook`
# Python toolchain, AWS/Kubernetes/secrets, and build deps. See MACHINES.md.
tap "mongodb/brew"

brew "apache-arrow"
brew "aws-sam-cli"
brew "cmake"
brew "gh"
brew "gopass"
brew "helm"
brew "lazygit"
brew "llvm@21"
brew "neovim"
brew "ollama"
brew "protobuf@33"
brew "pyenv"
brew "python@3.13"
brew "vault-cli"
brew "wget"
brew "zellij"

# Installed but absent from `brew leaves`, so add them by hand.
#
# Homebrew now requires tap trust. mongodb/brew is a third-party tap, so on a
# rebuilt machine these two are silently IGNORED by `brew bundle` until trusted.
# Prefer the narrow form over trusting the whole tap:
#   brew trust --formula mongodb/brew/mongodb-community@7.0 mongodb/brew/mongodb-database-tools
brew "mongodb/brew/mongodb-community@7.0"
brew "mongodb/brew/mongodb-database-tools"
