# Work MacBook Pro only. `brew bundle --file=Brewfile.macbook`
# Not installed on the Mac Mini unless a personal project needs it.
tap "mongodb/brew"

# Python toolchain — see local/zshrc.local.macbook.example
brew "pyenv"
brew "python@3.13"

# AWS / Kubernetes / secrets
brew "aws-sam-cli"
brew "helm"
brew "vault-cli"
brew "gopass"

# Build + data
brew "cmake"
brew "llvm@21"
brew "apache-arrow"
brew "protobuf@33"
