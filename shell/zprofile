# Homebrew environment, static equivalent of `eval "$(brew shellenv zsh)"`.
# brew shellenv forks brew's wrapper (~45ms) on every login shell just to print
# these lines. Checks the three standard prefixes and does nothing on a machine
# without Homebrew (a Raspberry Pi or Proxmox guest using apt).
#   /opt/homebrew               Apple Silicon
#   /usr/local                  Intel Mac (repository in /usr/local/Homebrew)
#   /home/linuxbrew/.linuxbrew  Homebrew on Linux, if ever installed
for _p in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  [ -x "$_p/bin/brew" ] || continue
  export HOMEBREW_PREFIX="$_p"
  export HOMEBREW_CELLAR="$_p/Cellar"
  if [ -d "$_p/Homebrew" ]; then
    export HOMEBREW_REPOSITORY="$_p/Homebrew"
  else
    export HOMEBREW_REPOSITORY="$_p"
  fi
  export PATH="$_p/bin:$_p/sbin:$PATH"
  export INFOPATH="$_p/share/info:${INFOPATH:-}"
  fpath=("$_p/share/zsh/site-functions" $fpath)
  break
done
unset _p
